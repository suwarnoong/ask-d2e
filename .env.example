# Environment variables for ask-d2e.
#
# This file documents every variable the code reads locally, on Vercel, and in
# GitHub Actions. Real values are never committed — see docs/ENVIRONMENT.md for
# where each one actually gets pasted (Vercel dashboard vs GitHub repo secrets).
#
# [Vercel]  = needed by the serverless functions (api/*.ts) and/or the build step
# [Actions] = needed by GitHub Actions workflows (kb-initial-build.yml, kb-correct.yml)
# [local]   = only useful for running scripts locally (tsx src/kb/*.ts, npm test)

# ---------------------------------------------------------------------------
# Slack app credentials
# ---------------------------------------------------------------------------

# Required. [Vercel]
# Slack app -> Basic Information -> App Credentials -> Signing Secret.
# Verifies every incoming Slack request (slash commands, events, interactions).
SLACK_SIGNING_SECRET=

# Required. [Vercel] [Actions]
# Slack app -> OAuth & Permissions -> Bot User OAuth Token (xoxb-...).
# Vercel posts replies; Actions posts threaded correction/gap-fill notices.
SLACK_BOT_TOKEN=

# ---------------------------------------------------------------------------
# Claude access (subscription-based; see docs/PLAN.md)
# ---------------------------------------------------------------------------

# Required. [Vercel] [Actions]
# Run `claude setup-token` once on a machine logged into a Claude Pro/Max
# subscription; the printed token is valid ~1 year. Required outright by the
# Actions CLI wrapper (no fallback); preferred (with ANTHROPIC_API_KEY as an
# optional fallback) by the Q&A path.
CLAUDE_CODE_OAUTH_TOKEN=

# Optional. [Vercel]
# Only used by the Q&A path (api/_lib/answer.ts) if CLAUDE_CODE_OAUTH_TOKEN is
# unset. Not read by the Actions CLI wrapper at all.
ANTHROPIC_API_KEY=

# Optional. [Vercel] [Actions]
# Shared model override — every task below falls back to this, then to its
# own hardcoded default, if unset. Also used directly (no dedicated per-task
# var) by the wizard's crafting call and by classifyRepoForQuestion's
# classification call, both of which fall back to their own defaults below.
CLAUDE_MODEL=

# Optional. [Vercel]
# Q&A-path model override (api/_lib/answer.ts). Falls back to CLAUDE_MODEL,
# then this default.
ANSWER_MODEL=claude-sonnet-4-5

# Optional. [Actions]
# Per-task model overrides for GitHub Actions workflows. Each falls back to
# CLAUDE_MODEL, then its own default shown here.
# (The wizard's crafting call and the correction/self-heal classification
# call have no dedicated override var — they only respect CLAUDE_MODEL above,
# falling back to claude-sonnet-4-5 and claude-haiku-4-5 respectively.)
INITIAL_BUILD_MODEL=claude-sonnet-4-5
CORRECT_MODEL=claude-sonnet-4-5

# Optional. [Vercel]
# Retry budget for transient 429/529/5xx from the Claude API on the Q&A path.
# Defaults to 5 if unset.
ANSWER_MAX_RETRIES=

# Optional. [Actions] [local]
# Per-call timeout (ms) for the `claude` CLI wrapper before it's SIGKILLed.
# Defaults to 120000 (2 min); each workflow overrides this higher itself
# (initial-build: 900000, correct: 600000) via the workflow YAML env block.
CLAUDE_TIMEOUT_MS=

# ---------------------------------------------------------------------------
# GitHub tokens
# ---------------------------------------------------------------------------

# Required. [Vercel] [Actions]
# contents:write on suwarnoong/ask-d2e-kb. Actions uses it to checkout+push
# KB edits; Vercel's build step uses it (as KB_REPO_TOKEN) to clone the KB
# bundle. Reusing one write-scoped token is simplest.
KB_REPO_TOKEN=

# Required, once any repo is onboarded. [Actions]
# contents:read across every configured source repo. Assumes one token can
# see them all (same org/user) — not solved generically for multi-org.
SOURCE_REPOS_TOKEN=

# Required. [Vercel]
# actions:write on ask-d2e — lets the wizard/feedback handlers dispatch
# kb-initial-build.yml / kb-correct.yml via the GitHub REST API.
GITHUB_DISPATCH_TOKEN=

# ---------------------------------------------------------------------------
# KB repo & registry config
# ---------------------------------------------------------------------------

# Required. [Actions] (local git-clone-based tests don't need this)
# GitHub Actions checkout steps reference suwarnoong/ask-d2e-kb directly in
# the workflow YAML, so this isn't actually read as an env var there today.
# scripts/build-kb-bundle.mjs (the Vercel build step) does read it:
KB_REPO=suwarnoong/ask-d2e-kb

# Optional. [Vercel]
# Branch the Vercel build step clones the KB bundle from. Defaults to "main".
KB_BRANCH=

# Optional. [Actions]
# Branch GitHub Actions push KB edits to. Defaults to "main" — set to an
# unprotected branch if "main" blocks direct pushes.
KB_TARGET_BRANCH=

# Optional. [local]
# Local-only escape hatch: runs the plan/write steps and prints the would-be
# registry mutation, but skips commit/push/dispatch/notify. Never set this in
# a deployed environment (Vercel or Actions).
KB_DRY_RUN=

# Optional. [local]
# Working-directory overrides for src/kb/initialBuild.ts and src/kb/correct.ts
# when running them outside a GitHub Actions checkout. In Actions these are
# set by the workflow YAML to ${{ github.workspace }}/kb and /src-checkout.
KB_ROOT=./kb
SOURCE_DIR=./src-checkout

# ---------------------------------------------------------------------------
# Admin allowlist
# ---------------------------------------------------------------------------

# Required. [Vercel]
# Comma-separated Slack user IDs. Checked before any admin action is shown or
# any correction/wizard flow is dispatched. Known so far: U0AEL63VB8B.
KB_FEEDBACK_ADMIN_IDS=

# ---------------------------------------------------------------------------
# Deploy hook
# ---------------------------------------------------------------------------

# Optional (becomes required once you want auto-redeploy on KB changes).
# [Actions]
# Vercel project -> Settings -> Git -> Deploy Hooks. Curled at the end of
# kb-initial-build.yml/kb-correct.yml so the live site picks up KB changes
# automatically. If unset, the code just skips the curl — no error.
DEPLOY_HOOK_URL=

# ---------------------------------------------------------------------------
# Optional Slack webhook fallback (correct.ts notify path only)
# ---------------------------------------------------------------------------

# Optional. [Actions]
# Only used as a fallback if a correction has no slack_channel/thread_ts to
# reply into directly (e.g. a 👎 on an ephemeral slash-command reply with no
# real thread). One or more incoming webhook URLs, comma/newline-separated.
SLACK_WEBHOOK_URLS=
